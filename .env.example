# Firebase (Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Only emails on this domain may log in
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit

# Optional (bonus): comma-separated emails that get the admin role
EXPO_PUBLIC_ADMIN_EMAILS=

# Native (Android/iOS) Google OAuth client IDs, from Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
